<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="mobile_background">#0B0D10</color>
    <color name="car_background">#17181B</color>

    <!-- 모바일 앱: 휴대폰이 어둡게 설정이면 어두운 화면 -->
    <style name="MobileTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/mobile_background</item>
        <item name="android:statusBarColor">@color/mobile_background</item>
        <item name="android:navigationBarColor">@color/mobile_background</item>
    </style>
</resources>
